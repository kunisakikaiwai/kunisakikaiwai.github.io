---
// 「いいね」とコメント送信欄（日英対応）。
// どちらも FormSubmit.co 経由で kunisakikaiwai@gmail.com へメール送信される。
// コメントはページには表示されない。
// 注意: FormSubmit の承認はドメインごと。新しいドメインで公開したら、
// 最初の送信後に届く Activate メールの承認が必要。
interface Props {
  pageTitle: string;
  lang?: 'jp' | 'en';
}
const { pageTitle, lang = 'jp' } = Astro.props;
const ENDPOINT = 'https://formsubmit.co/ajax/cd8fa2c7d83cb0ec94d0626a19e0ea2f';

const L = lang === 'en' ? {
  like: '♡ Like',
  liked: '♥ Liked',
  sending: 'Sending…',
  thanks: 'Thank you!',
  sent: 'Sent. Thank you!',
  fail: 'Could not send. Please try again later.',
  summary: 'Send a comment',
  note: 'Comments are not published on this page. They go directly to the site owner.',
  name: 'Your name (optional)',
  message: 'Your thoughts, questions, corrections…',
  send: 'Send',
} : {
  like: '♡ いいね',
  liked: '♥ いいね済み',
  sending: '送信中…',
  thanks: 'ありがとうございます！',
  sent: '送信しました。ありがとうございます！',
  fail: '送信できませんでした。時間をおいてお試しください。',
  summary: 'ご意見・ご感想を送る',
  note: 'いただいたコメントはページには公開されません。管理人に直接届きます。',
  name: 'お名前（任意）',
  message: 'ご感想、お気づきの点などをどうぞ',
  send: '送信する',
};
---

<section class="feedback" data-endpoint={ENDPOINT} data-page={pageTitle}
  data-l-liked={L.liked} data-l-sending={L.sending} data-l-thanks={L.thanks}
  data-l-sent={L.sent} data-l-fail={L.fail}>
  <div class="like-row">
    <button id="like-btn" type="button" aria-label="like">{L.like}</button>
    <span id="like-msg" role="status"></span>
  </div>

  <details class="comment-box">
    <summary>{L.summary}</summary>
    <p class="note">{L.note}</p>
    <form id="comment-form">
      <input type="text" name="name" placeholder={L.name} autocomplete="name" />
      <input type="text" name="_honey" class="hp" tabindex="-1" autocomplete="off" />
      <textarea name="message" rows="4" required placeholder={L.message}></textarea>
      <div class="send-row">
        <button type="submit">{L.send}</button>
        <span id="comment-msg" role="status"></span>
      </div>
    </form>
  </details>
</section>

<script>
  const root = document.querySelector('.feedback') as HTMLElement;
  const endpoint = root.dataset.endpoint!;
  const page = root.dataset.page!;
  const L = {
    liked: root.dataset.lLiked!,
    sending: root.dataset.lSending!,
    thanks: root.dataset.lThanks!,
    sent: root.dataset.lSent!,
    fail: root.dataset.lFail!,
  };

  async function send(payload: Record<string, string>) {
    const res = await fetch(endpoint, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify({ _captcha: 'false', _template: 'table', ページ: page, ...payload }),
    });
    let body: any = null;
    try { body = await res.json(); } catch { /* no body */ }
    if (!res.ok || (body && body.success === 'false')) {
      console.error('[feedback] FormSubmit error:', res.status, body);
      throw new Error(body?.message || String(res.status));
    }
    return body;
  }

  // いいね
  const likeBtn = document.getElementById('like-btn') as HTMLButtonElement;
  const likeMsg = document.getElementById('like-msg')!;
  const likeKey = 'liked:' + location.pathname;
  if (localStorage.getItem(likeKey)) {
    likeBtn.textContent = L.liked;
    likeBtn.disabled = true;
  }
  likeBtn.addEventListener('click', async () => {
    likeBtn.disabled = true;
    likeMsg.textContent = L.sending;
    try {
      await send({ _subject: `いいね: ${page}`, 種別: 'いいね' });
      localStorage.setItem(likeKey, '1');
      likeBtn.textContent = L.liked;
      likeMsg.textContent = L.thanks;
    } catch {
      likeBtn.disabled = false;
      likeMsg.textContent = L.fail;
    }
  });

  // コメント
  const form = document.getElementById('comment-form') as HTMLFormElement;
  const commentMsg = document.getElementById('comment-msg')!;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    if ((fd.get('_honey') as string)?.length) return; // bot
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.disabled = true;
    commentMsg.textContent = L.sending;
    try {
      await send({
        _subject: `コメント: ${page}`,
        種別: 'コメント',
        お名前: (fd.get('name') as string) || '（無記名）',
        本文: fd.get('message') as string,
      });
      form.reset();
      commentMsg.textContent = L.sent;
    } catch {
      commentMsg.textContent = L.fail;
    } finally {
      btn.disabled = false;
    }
  });
</script>

<style>
  .feedback {
    margin-top: 3rem;
    padding-top: 1.2rem;
    border-top: 1px solid #ddd;
  }
  .like-row {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }
  #like-btn {
    font-size: 1rem;
    padding: 0.45em 1.1em;
    border: 1px solid #c98a8a;
    border-radius: 2em;
    background: #fff;
    color: #b8352f;
    cursor: pointer;
  }
  #like-btn:hover:not(:disabled) {
    background: #fdf0ef;
  }
  #like-btn:disabled {
    border-color: #ddd;
    color: #b8352f;
    cursor: default;
  }
  #like-msg, #comment-msg {
    font-size: 0.85rem;
    color: #666;
  }
  .comment-box {
    margin-top: 1.2rem;
  }
  .comment-box summary {
    cursor: pointer;
    color: #444;
    font-size: 0.95rem;
  }
  .note {
    font-size: 0.85rem;
    color: #666;
    margin: 0.6rem 0;
  }
  #comment-form input[type='text'],
  #comment-form textarea {
    display: block;
    width: 100%;
    max-width: 560px;
    margin-bottom: 0.7rem;
    padding: 0.5em 0.7em;
    border: 1px solid #ccc;
    border-radius: 6px;
    font: inherit;
    box-sizing: border-box;
  }
  .hp {
    display: none !important;
  }
  .send-row {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }
  .send-row button {
    font-size: 0.95rem;
    padding: 0.45em 1.4em;
    border: 1px solid #8a939b;
    border-radius: 6px;
    background: #f5f5f2;
    cursor: pointer;
  }
  .send-row button:hover:not(:disabled) {
    background: #ecece7;
  }
</style>
