---
import Layout from '../../../layouts/Layout.astro';
import StoryFeedback from '../../../components/StoryFeedback.astro';

export async function getStaticPaths() {
  const posts = Object.values(
    import.meta.glob('../../../content/jp/rabithole/*.{md,mdx}', { eager: true })
  );

  return posts.map((post: any) => ({
    params: { slug: post.frontmatter.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const BlogPost = post.default;
// ランディング(01-top)はシリーズ名と話数の重複表示を避ける
const isHome = post.frontmatter.slug === '01-top';
---

<Layout title={`${post.frontmatter.title} | 国東界隈`}>
  <main>
    <article>
      {!isHome && <div class="series-title">国東界隈、ねほりはほり編</div>}
      <h2>{isHome ? post.frontmatter.title : `${post.frontmatter.order}: ${post.frontmatter.title}`}</h2>

      <div class="meta">
        {post.frontmatter.date}
        {post.frontmatter.author && ` / ${post.frontmatter.author}`}
      </div>

      <BlogPost />

      <hr />

      <StoryFeedback pageTitle={`ねほりはほり: ${post.frontmatter.title}`} />

    </article>
  </main>
</Layout>

<style>
  .series-title {
    color: #666;
    font-size: 1.05rem;
    margin-bottom: 0.2rem;
  }
  article h2 {
    margin-top: 0;
  }
  .meta {
    color: #777;
    font-size: 0.9rem;
    margin-bottom: 2rem;
  }
</style>