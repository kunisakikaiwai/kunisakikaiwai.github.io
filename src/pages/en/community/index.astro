---
import Layout from '../../../layouts/Layout.astro';
import StoryFeedback from '../../../components/StoryFeedback.astro';

const posts = Object.values(
  import.meta.glob('../../../content/en/community/blog/*.mdx', { eager: true })
).sort((a: any, b: any) =>
  new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime()
);
---

<Layout title="Connect | Kunisaki Kaiwai" lang="en">
  <main>
    <h2>Connect</h2>

    <h3>Kunisaki Journal</h3>

    <p>
    A community blog for sharing the scenery we've found in Kunisaki, the paths we've walked, the stories we've heard, and the things we've felt.<br><br>
    Why not share what you've discovered in Kunisaki? Comments and thoughts about the site are welcome too —
        <a href="#" id="open-message">send us a message</a>.
      </p>

    <h4>
      Recent posts:
    </h4>

    <ul class="blog-list">
      {posts.map((post: any) => (
        <li>
          <a href={`/en/community/blog/${post.frontmatter.slug}/`}>
            {post.frontmatter.title}
          </a>
          <div class="meta">
            {post.frontmatter.date}
            {post.frontmatter.author && ` / ${post.frontmatter.author}`}
          </div>
        </li>
      ))}
    </ul>

    <h3>Stay in Kunisaki</h3>

    <p>
    For your nights on the peninsula, visit <a href="/en/stay/">Stay in Kunisaki</a> —
    a guesthouse on a quiet cove near the tip of the peninsula.
    </p>

    <h3>About This Site</h3>

    <p>
    This site is run as a companion site of <a href="https://kibehouse.jp/en/">Kibe House</a>, a guesthouse in Kunisaki City.
    </p>

    <StoryFeedback pageTitle="Connect" lang="en" />
  </main>
</Layout>

<script>
  const openLink = document.getElementById('open-message');
  openLink?.addEventListener('click', (e) => {
    e.preventDefault();
    const box = document.querySelector('.feedback details') as HTMLDetailsElement | null;
    if (box) {
      box.open = true;
      box.scrollIntoView({ behavior: 'smooth' });
    }
  });
</script>

<style>
  .blog-list {
    list-style: none;
    padding: 0;
  }

  .blog-list li {
    margin-bottom: 1.4rem;
  }

  .meta {
    font-size: 0.9rem;
    color: #777;
    margin-top: 0.2rem;
  }
</style>
