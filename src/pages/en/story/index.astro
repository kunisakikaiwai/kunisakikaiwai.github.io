---
import Layout from '../../../layouts/Layout.astro';

const chapters = Object.values(
  import.meta.glob('../../../content/en/story/*.mdx', { eager: true })
)
  .filter((post: any) => post.frontmatter?.slug)
  .sort((a: any, b: any) => {
    return (a.frontmatter.order ?? 999) - (b.frontmatter.order ?? 999);
  });
---

<Layout title="The Kunisaki Chronicle | Kunisaki Kaiwai" lang="en">
  <main>
    <h2>The Kunisaki Chronicle</h2>
    <p class="series-sub">1,300 years of Kunisaki, drawn from the sources</p>

    <p>
      From a peninsula born of volcanoes to the meeting of gods and buddhas,
      and the rise of the Rokugo Manzan world — 1,300 years of history in eleven chapters.
    </p>

    <ul class="toc">
      {chapters.map((post: any) => (
        <li>
          <a href={`/en/story/${post.frontmatter.slug}/`}>
            {post.frontmatter.title}
          </a>
        </li>
      ))}
    </ul>

    <p>
      Curious about the questions the tales left open?
      Follow us <a href="/en/rabithole/01-top/">down the rabbit hole</a>.
    </p>
    <p>
      And if you would rather see these centuries through the eyes of someone who lived them,
      <a href="/en/tales/">Kunisaki Stories</a> is a cycle of short fiction — clearly marked as such — set in the same places.
    </p>
  </main>
</Layout>

<style>
  .series-sub {
    margin-top: -0.6rem;
    color: #666;
  }
  .toc {
    list-style: none;
    padding-left: 0;
  }
</style>
