---
import '../styles/site.css';

const { title, lang = "jp", font } = Astro.props;
const isEn = lang === "en";
// font="reading" => serif (en) / mincho (jp); otherwise => sans (en) / gothic (jp)
const reading = font === "reading" || font === "mincho";
const bodyClass = isEn
  ? reading
    ? "en-serif"
    : "en-sans"
  : reading
    ? "ja-mincho"
    : "ja-gothic";
const base = isEn ? "/en" : "/jp";
const htmlLang = isEn ? "en" : "ja";
const pageTitle = title ?? "国東界隈";

const nav = isEn
  ? [
      { href: `${base}/`, label: "Home" },
      { href: `${base}/feel/`, label: "Feel Kunisaki" },
      { href: `${base}/`, label: "Learn Kunisaki" },
      { href: `${base}/walk/`, label: "Walk Kunisaki" },
      { href: `${base}/kunisakiology/`, label: "Kunisaki Love Test" },
      { href: `${base}/community/`, label: "Community" },
      { href: `${base}/about/`, label: "About" },
    ]
  : [
      { href: `${base}/`, label: "ホーム" },
      { href: `${base}/feel/`, label: "国東を感じる" },
      { href: `${base}/`, label: "国東を知る" },
      { href: `${base}/walk/`, label: "国東を歩く" },
      { href: `${base}/kunisakiology/`, label: "国東愛検定" },
      { href: `${base}/community/`, label: "コミュニティ" },
      { href: `${base}/about/`, label: "サイト情報" },
    ];
---

<!doctype html>

    <html lang={htmlLang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <title>{pageTitle}</title>

        <!-- Google tag (gtag.js) -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-H0BRLBY4TY"></script>
        <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        gtag('config', 'G-H0BRLBY4TY');
        </script>
    </head>

    <body class={bodyClass}>
    <header class="site-top">
        <div class="top-bar">
            <div class="site-logo">
                <a href={`${base}/`}>
                    <img
                        src="/images/logo/kunisaki-kaiwai_logo.png"
                        alt="国東界隈 Kunisaki Kaiwai"
                        class="logo-img"
                    />
                </a>
            </div>

            <div class="top-right">
                <div class="lang-switch">
                    <a href="/jp/">日本語</a> |
                    <a href="/en/">English</a>
                </div>

                <nav class="main-menu">
                    {nav.map((item) => <a href={item.href}>{item.label}</a>)}
                </nav>

                <style>
                    /* 国東かいわい側のみ: メニュー項目が多いため共通の 1.15rem より少し小さく */
                    .main-menu {
                        font-size: 1rem;
                    }
                </style>
            </div>
        </div>
    </header>


    <header class="site-header">
        <a href={`${base}/`}>
        <img src="/images/Header.png" alt="Kunisaki Peninsula" />
        </a>
    </header>

    <div class="container">
        <slot />
    </div>
    </body>



    <hr class="footer-divider">
    <footer class="site-footer">
    <div class="footer-inner">

        <div class="footer-title">
        <h3>国東界隈 | Kunisaki Kaiwai</h3>
        </div>

        <nav class="footer-links">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>

        <p class="copyright">
        © 2026 Kunisaki Kaiwai
        </p>

        </div>
    </footer>

</html>
